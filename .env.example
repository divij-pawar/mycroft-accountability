# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ─── LangChain settings — the one agent framework (adapters/langchain_adapter.py) ───
# Which model LangChain drives by default. A name containing "gemini" selects
# the Gemini family (needs GEMINI_API_KEY below); anything else selects Ollama.
LANGCHAIN_MODEL=llama3.2

# Seconds a model call may receive nothing before it is abandoned and the run is
# recorded as halted. For Ollama (which streams) this is a stall limit, not a cap
# on how long a call takes. Unset means 120, above the slowest successful attempt
# stored so far (85.3 s). See MODEL_TIMEOUT_S in langchain_adapter.py.
MODEL_TIMEOUT_S=120

# Tokens one model call may generate. The timeout above can't stop a model that keeps
# talking (llama3.2 once generated 10,341 tokens for one answer). Unset means 2048,
# about 2.5x the longest successful answer stored so far.
MODEL_MAX_TOKENS=2048

# Characters of planned-search results put in the agent's Context when it is given no
# Context of its own. Unset means 3000: at 6000 llama3.2 looped or lost its format.
SEARCH_RESULTS_CHAR_LIMIT=3000

# ─── Access (web/auth.py) ──────────────────────────────────────────────────
# The key an auditor token needs (sent as X-Admin-Key), and what /mcp needs as a Bearer
# token. scripts/start-server.sh generates one into .env if this is empty. Without a key,
# auditor tokens are refused. An investor token is open to anyone.
ACCOUNTABILITY_ADMIN_KEY=
# Signs the tokens. Unset means a random secret per server process, so tokens stop working
# when the server restarts (the review app fetches a new one).
ACCOUNTABILITY_SECRET=
# Off by default. 1 lets DELETE /api/runs drop every table, the append-only decisions included.
ACCOUNTABILITY_ALLOW_CLEAR=
# Off by default. 1 restores the old open behaviour (anyone gets an auditor token, a public
# signing secret, /mcp open). Only for a throwaway local session.
ACCOUNTABILITY_INSECURE_DEV=

# ─── Your own agent over MCP (web/mcp_server.py) ───────────────────────────
# Seconds the layer waits for an agent session (Claude Code, Codex, Cursor) to submit one
# reply before the run is halted. A person may be reading along, so this is long.
AGENT_SESSION_TIMEOUT_S=900
# The base URL the MCP tools give out as `watch` and `record` links.
MYCROFT_APP_URL=http://localhost:8000

# ─── Google Gemini (optional — only needed if LANGCHAIN_MODEL is a Gemini-family name) ───
# Google AI Studio key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Tavily search (optional, the agent's tool — see langchain_adapter.py) ─
# Free tier available — https://tavily.com
# Leave empty to skip: the tool still binds, but a search call will fail
# (surfaced as a real error, not a silent skip) — see
# adapters/registry.py's ProviderSpec.supports_tools.
TAVILY_API_KEY=

# ─── SEC EDGAR (datasources/edgar.py) ─────────────────────────────────────
# SEC's fair-access policy asks every client to identify itself with a real
# contact in the User-Agent, e.g. "my-app you@example.com". Unset uses a
# placeholder that SEC may throttle or block under heavier use.
SEC_USER_AGENT=

# ─── Alpha Vantage (the financial agent's price source — financial_agent/prices.py) ───
# A free key gets 100 daily bars and the full weekly series, 25 requests a day and
# 1 a second. Without it, a price fetch fails with "no_key". https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# ─── Self-hosted LangFuse observability (optional, for tracing) ───────────
# Start LangFuse with: cd ../.langfuse && docker-compose up -d
# Then get API keys from http://localhost:3000 (Settings → Projects → API Keys)
# Leave empty/unset for graceful degradation (tracing disabled, no errors)

# LangFuse host URL
LANGFUSE_HOST=http://localhost:3000

# LangFuse project API key (public key)
LANGFUSE_PUBLIC_KEY=

# LangFuse project secret key
LANGFUSE_SECRET_KEY=
