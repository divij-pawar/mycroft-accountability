# Scoped to verification-layer/ — this subsystem keeps its own ignore rules so
# nothing it needs has to be added to the repo root .gitignore.
# (The root already covers .env, __pycache__/ and *.pyc repo-wide.)

*/__pycache__
__pycache__/
*.pyc
.env
/.claude

# Runtime data — never commit the DB or persisted run history.
# The run store is machine-local; runs are reproduced by replay, not by commit.
web/data/*.db
# SQLite WAL sidecars � same category as the .db, and they were showing up as
# untracked because only *.db was listed.
web/data/*.db-shm
web/data/*.db-wal
web/data/*.json
web/data/*.json.migrated
# BP: filings fetched from SEC on demand (datasources/filings.py) — regenerable.
web/data/filing_cache/

# Local-only bulk that must never enter version control
/env
/openclaw
/youtube
/context
/divij

# docs/ is tracked for design docs (DATA_CONTRACT.md) and its own index,
# but the weekly walkthrough decks are large local-only artefacts.
/docs/*.html
!/docs/index.html

# Accidental pip install artefacts (e.g. a file literally named "=2.8.0")
=*

# React frontend (web/frontend/) — installed and built artefacts regenerate from
# package.json + package-lock.json (committed) and the source.
web/frontend/node_modules/
web/frontend/dist/
web/frontend/*.tsbuildinfo
